# Set the Supabase PostgreSQL URI as a secret/environment variable on the API host.
# Copy the URI from Supabase Dashboard > Connect and include sslmode=require.
DATABASE_URL=postgresql://postgres:YOUR_DATABASE_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres?sslmode=require
# Optional application-specific name; it takes precedence over DATABASE_URL.
# AVM_DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require

# Experimental inference model (catboost, xgboost, or random_forest).
AVM_DEFAULT_MODEL=catboost
# Optional additional output multiplier. Keep at 1.0 for the evaluated CatBoost process.
AVM_OUTPUT_ADJUSTMENT_FACTOR=1.0
